# Production build config (committed on purpose — these are public values).
# NEXT_PUBLIC_* vars are inlined at build time, so having them here means every
# production build (local `npm run deploy` or CI) reads the live snapshot with
# nothing to remember to set.
NEXT_PUBLIC_CLUB_ID=8623640
NEXT_PUBLIC_PLATFORM=common-gen5
NEXT_PUBLIC_CLUB_NAME=Stolio Goalio
NEXT_PUBLIC_SNAPSHOT_URL=https://raw.githubusercontent.com/atn/stoliogoalio/data/snapshot.json
